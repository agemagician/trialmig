PROCEDURE DIVISION USING LK-MSG LK-LEN LK-DIGEST.
MAIN-PARA.
    IF WS-POW-INIT = 0
        MOVE 1 TO WS-POW2(1)
        PERFORM VARYING WS-I FROM 2 BY 1 UNTIL WS-I > 33
            COMPUTE WS-POW2(WS-I) = WS-POW2(WS-I - 1) * 2
        END-PERFORM
        MOVE 1 TO WS-POW-INIT
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
        MOVE HI-WORD(WS-I) TO WS-HW(WS-I)
    END-PERFORM
    PERFORM BUILD-PADDED
    PERFORM VARYING WS-BLK FROM 1 BY 1 UNTIL WS-BLK > WS-NBLK
        COMPUTE WS-BASE = (WS-BLK - 1) * 64
        PERFORM COMPRESS-BLOCK
    END-PERFORM
    PERFORM EMIT-DIGEST
    GOBACK.

*> Message || 0x80 || zeros || 64-bit bit length, padded to a multiple of 64.
BUILD-PADDED.
    MOVE LOW-VALUES TO WS-BUF
    IF LK-LEN > 0
        MOVE LK-MSG(1:LK-LEN) TO WS-BUF(1:LK-LEN)
    END-IF
    MOVE X"80" TO WS-BUF(LK-LEN + 1:1)
    COMPUTE WS-NBLK = (LK-LEN + 9 + 63) / 64
    COMPUTE WS-TOTAL = WS-NBLK * 64
    COMPUTE WS-BITLEN = LK-LEN * 8
    COMPUTE WS-BYTE = FUNCTION MOD(WS-BITLEN, 256)
    MOVE FUNCTION CHAR(WS-BYTE + 1) TO WS-BUF(WS-TOTAL:1)
    COMPUTE WS-BYTE = WS-BITLEN / 256
    MOVE FUNCTION CHAR(WS-BYTE + 1) TO WS-BUF(WS-TOTAL - 1:1).

COMPRESS-BLOCK.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 16
        COMPUTE WS-J = WS-BASE + (WS-I - 1) * 4
        COMPUTE WS-T1 =
            (FUNCTION ORD(WS-BUF(WS-J + 1:1)) - 1) * 16777216
          + (FUNCTION ORD(WS-BUF(WS-J + 2:1)) - 1) * 65536
          + (FUNCTION ORD(WS-BUF(WS-J + 3:1)) - 1) * 256
          + (FUNCTION ORD(WS-BUF(WS-J + 4:1)) - 1)
        MOVE WS-T1 TO WS-W(WS-I)
    END-PERFORM
    PERFORM VARYING WS-I FROM 17 BY 1 UNTIL WS-I > 64
        MOVE WS-W(WS-I - 2) TO WS-X
        MOVE 17 TO WS-N1
        MOVE 19 TO WS-N2
        MOVE 10 TO WS-N3
        MOVE "Y" TO WS-SHIFT3
        PERFORM SIGMA
        MOVE WS-R TO WS-P1
        MOVE WS-W(WS-I - 15) TO WS-X
        MOVE 7 TO WS-N1
        MOVE 18 TO WS-N2
        MOVE 3 TO WS-N3
        PERFORM SIGMA
        COMPUTE WS-T1 = WS-P1 + WS-W(WS-I - 7) + WS-R + WS-W(WS-I - 16)
        COMPUTE WS-W(WS-I) = FUNCTION MOD(WS-T1, 4294967296)
    END-PERFORM
    MOVE WS-HW(1) TO WS-A
    MOVE WS-HW(2) TO WS-B
    MOVE WS-HW(3) TO WS-C
    MOVE WS-HW(4) TO WS-D
    MOVE WS-HW(5) TO WS-E
    MOVE WS-HW(6) TO WS-F
    MOVE WS-HW(7) TO WS-G
    MOVE WS-HW(8) TO WS-HH
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 64
        PERFORM ONE-ROUND
    END-PERFORM
    COMPUTE WS-HW(1) = FUNCTION MOD(WS-HW(1) + WS-A, 4294967296)
    COMPUTE WS-HW(2) = FUNCTION MOD(WS-HW(2) + WS-B, 4294967296)
    COMPUTE WS-HW(3) = FUNCTION MOD(WS-HW(3) + WS-C, 4294967296)
    COMPUTE WS-HW(4) = FUNCTION MOD(WS-HW(4) + WS-D, 4294967296)
    COMPUTE WS-HW(5) = FUNCTION MOD(WS-HW(5) + WS-E, 4294967296)
    COMPUTE WS-HW(6) = FUNCTION MOD(WS-HW(6) + WS-F, 4294967296)
    COMPUTE WS-HW(7) = FUNCTION MOD(WS-HW(7) + WS-G, 4294967296)
    COMPUTE WS-HW(8) = FUNCTION MOD(WS-HW(8) + WS-HH, 4294967296).

ONE-ROUND.
    *> T1 = h + S1(e) + Ch(e,f,g) + K + W ; T2 = S0(a) + Maj(a,b,c)
    MOVE WS-E TO WS-X
    MOVE 6 TO WS-N1
    MOVE 11 TO WS-N2
    MOVE 25 TO WS-N3
    MOVE "N" TO WS-SHIFT3
    PERFORM SIGMA
    MOVE WS-R TO WS-P1
    COMPUTE WS-NOT = 4294967295 - WS-E
    MOVE WS-E TO WS-P2
    CALL "CBL_AND" USING WS-F WS-P2 BY VALUE WS-LEN4
    MOVE WS-NOT TO WS-P3
    CALL "CBL_AND" USING WS-G WS-P3 BY VALUE WS-LEN4
    CALL "CBL_XOR" USING WS-P3 WS-P2 BY VALUE WS-LEN4
    COMPUTE WS-T1 = WS-HH + WS-P1 + WS-P2 + K-WORD(WS-I) + WS-W(WS-I)
    MOVE WS-A TO WS-X
    MOVE 2 TO WS-N1
    MOVE 13 TO WS-N2
    MOVE 22 TO WS-N3
    PERFORM SIGMA
    MOVE WS-R TO WS-P1
    MOVE WS-A TO WS-P2
    CALL "CBL_AND" USING WS-B WS-P2 BY VALUE WS-LEN4
    MOVE WS-A TO WS-P3
    CALL "CBL_AND" USING WS-C WS-P3 BY VALUE WS-LEN4
    CALL "CBL_XOR" USING WS-P3 WS-P2 BY VALUE WS-LEN4
    MOVE WS-B TO WS-P3
    CALL "CBL_AND" USING WS-C WS-P3 BY VALUE WS-LEN4
    CALL "CBL_XOR" USING WS-P3 WS-P2 BY VALUE WS-LEN4
    COMPUTE WS-T2 = WS-P1 + WS-P2
    MOVE WS-G TO WS-HH
    MOVE WS-F TO WS-G
    MOVE WS-E TO WS-F
    COMPUTE WS-E = FUNCTION MOD(WS-D + WS-T1, 4294967296)
    MOVE WS-C TO WS-D
    MOVE WS-B TO WS-C
    MOVE WS-A TO WS-B
    COMPUTE WS-A = FUNCTION MOD(WS-T1 + WS-T2, 4294967296).

*> WS-R = ROTR(X,N1) ^ ROTR(X,N2) ^ (SHR|ROTR)(X,N3).
SIGMA.
    MOVE WS-N1 TO WS-N
    PERFORM ROTR
    MOVE WS-R TO WS-P2
    MOVE WS-N2 TO WS-N
    PERFORM ROTR
    CALL "CBL_XOR" USING WS-R WS-P2 BY VALUE WS-LEN4
    IF WS-SHIFT3 = "Y"
        DIVIDE WS-X BY WS-POW2(WS-N3 + 1) GIVING WS-Q REMAINDER WS-REM
        MOVE WS-Q TO WS-R
    ELSE
        MOVE WS-N3 TO WS-N
        PERFORM ROTR
    END-IF
    CALL "CBL_XOR" USING WS-P2 WS-R BY VALUE WS-LEN4.

ROTR.
    DIVIDE WS-X BY WS-POW2(WS-N + 1) GIVING WS-Q REMAINDER WS-REM
    COMPUTE WS-R = WS-Q + WS-REM * WS-POW2(33 - WS-N).

EMIT-DIGEST.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
        MOVE WS-HW(WS-I) TO WS-T1
        COMPUTE WS-J = (WS-I - 1) * 4
        DIVIDE WS-T1 BY 16777216 GIVING WS-Q REMAINDER WS-REM
        MOVE FUNCTION CHAR(WS-Q + 1) TO LK-DIGEST(WS-J + 1:1)
        DIVIDE WS-REM BY 65536 GIVING WS-Q REMAINDER WS-T1
        MOVE FUNCTION CHAR(WS-Q + 1) TO LK-DIGEST(WS-J + 2:1)
        DIVIDE WS-T1 BY 256 GIVING WS-Q REMAINDER WS-REM
        MOVE FUNCTION CHAR(WS-Q + 1) TO LK-DIGEST(WS-J + 3:1)
        MOVE FUNCTION CHAR(WS-REM + 1) TO LK-DIGEST(WS-J + 4:1)
    END-PERFORM.
