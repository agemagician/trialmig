*> All output file handling. MAIN never opens an output file. Rows are staged per
*> cohort under work/stage/<cohort>/ as they are decoded; at the end PROMOTE copies
*> WRITTEN cohorts into work/out/ and HELD cohorts into work/out/held/<cohort>/.
*> The cohort code names a directory, so MAIN validates it as [A-Z0-9]{1,8} first.
*> Ops: INIT, OPEN, PUT, CLOSE, PRMINIT, PROMOTE (kind WRIT or HELD), PRMDONE,
*> ROWS (kind PAT/LAB/AE/REJ -> count), LOG, QUIT.
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGEIO.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT S-PAT ASSIGN TO WS-N-SPAT ORGANIZATION LINE SEQUENTIAL FILE STATUS WS-FS.
    SELECT S-LAB ASSIGN TO WS-N-SLAB ORGANIZATION LINE SEQUENTIAL FILE STATUS WS-FS.
    SELECT S-AE ASSIGN TO WS-N-SAE ORGANIZATION LINE SEQUENTIAL FILE STATUS WS-FS.
    SELECT S-REJ ASSIGN TO WS-N-SREJ ORGANIZATION LINE SEQUENTIAL FILE STATUS WS-FS.
    SELECT O-PAT ASSIGN TO "work/out/patients.csv" ORGANIZATION LINE SEQUENTIAL
        FILE STATUS WS-FS.
    SELECT O-LAB ASSIGN TO "work/out/lab_results.csv" ORGANIZATION LINE SEQUENTIAL
        FILE STATUS WS-FS.
    SELECT O-AE ASSIGN TO "work/out/adverse_events.csv" ORGANIZATION LINE SEQUENTIAL
        FILE STATUS WS-FS.
    SELECT O-REJ ASSIGN TO "work/out/reject.csv" ORGANIZATION LINE SEQUENTIAL
        FILE STATUS WS-FS.
    SELECT IN-F ASSIGN TO WS-N-IN ORGANIZATION LINE SEQUENTIAL FILE STATUS WS-FS.
    SELECT H-F ASSIGN TO WS-N-H ORGANIZATION LINE SEQUENTIAL FILE STATUS WS-FS.
    SELECT LOG-F ASSIGN TO "diag/run.log" ORGANIZATION LINE SEQUENTIAL
        FILE STATUS WS-FS.
DATA DIVISION.
FILE SECTION.
FD S-PAT. 01 S-PAT-REC PIC X(400).
FD S-LAB. 01 S-LAB-REC PIC X(400).
FD S-AE. 01 S-AE-REC PIC X(400).
FD S-REJ. 01 S-REJ-REC PIC X(400).
FD O-PAT. 01 O-PAT-REC PIC X(400).
FD O-LAB. 01 O-LAB-REC PIC X(400).
FD O-AE. 01 O-AE-REC PIC X(400).
FD O-REJ. 01 O-REJ-REC PIC X(400).
FD IN-F. 01 IN-REC PIC X(400).
FD H-F. 01 H-REC PIC X(400).
FD LOG-F. 01 LOG-REC PIC X(400).
WORKING-STORAGE SECTION.
01 WS-FS PIC XX.
01 WS-N-SPAT PIC X(60).
01 WS-N-SLAB PIC X(60).
01 WS-N-SAE PIC X(60).
01 WS-N-SREJ PIC X(60).
01 WS-N-IN PIC X(60).
01 WS-N-H PIC X(60).
01 WS-DIR PIC X(60).
01 WS-EOF PIC X.
01 WS-DISP PIC X(8).
01 WS-LINE PIC X(400).
01 WS-OUT-ROWS PIC 9(9) OCCURS 4.
01 WS-K PIC 9.
01 WS-HDR-PAT PIC X(120) VALUE "src_rec_no,cohort,pseudo_id,birth_year,age,sex,site,enroll_date,arm,weight,height,consent,flags".
01 WS-HDR-LAB PIC X(120) VALUE "src_rec_no,cohort,pseudo_id,visit_seq,collect_date,panel_slot,test_code,result,unit,flags".
01 WS-HDR-AE PIC X(120) VALUE "src_rec_no,cohort,pseudo_id,event_seq,term,severity,onset_date,narrative_len,had_narrative,flags".
01 WS-HDR-REJ PIC X(120) VALUE "src_rec_no,byte_offset,type,cohort,reason,cohort_disposition".
LINKAGE SECTION.
01 LK-OP PIC X(8).
01 LK-COHORT PIC X(8).
01 LK-KIND PIC X(4).
01 LK-LINE PIC X(400).
01 LK-COUNT PIC 9(9).
01 LK-STATUS PIC 9.
PROCEDURE DIVISION USING LK-OP LK-COHORT LK-KIND LK-LINE LK-COUNT LK-STATUS.
MAIN-PARA.
    MOVE 0 TO LK-STATUS
    EVALUATE LK-OP
        WHEN "INIT    " PERFORM DO-INIT
        WHEN "OPEN    " PERFORM DO-OPEN
        WHEN "PUT     " PERFORM DO-PUT
        WHEN "CLOSE   " PERFORM DO-CLOSE
        WHEN "PRMINIT " PERFORM DO-PRMINIT
        WHEN "PROMOTE " PERFORM DO-PROMOTE
        WHEN "PRMDONE " PERFORM DO-PRMDONE
        WHEN "ROWS    " PERFORM DO-ROWS
        WHEN "LOG     "
            MOVE LK-LINE TO LOG-REC
            WRITE LOG-REC
        WHEN "QUIT    " CLOSE LOG-F
        WHEN OTHER MOVE 1 TO LK-STATUS
    END-EVALUATE
    IF WS-FS(1:1) NOT = "0" AND WS-FS NOT = "10"
        MOVE 1 TO LK-STATUS
    END-IF
    GOBACK.

DO-INIT.
    OPEN OUTPUT LOG-F
    CALL "CBL_CREATE_DIR" USING "work/stage".

STAGE-NAMES.
    MOVE SPACES TO WS-DIR WS-N-SPAT WS-N-SLAB WS-N-SAE WS-N-SREJ
    STRING "work/stage/" FUNCTION TRIM(LK-COHORT) DELIMITED BY SIZE INTO WS-DIR
    STRING FUNCTION TRIM(WS-DIR) "/p.csv" DELIMITED BY SIZE INTO WS-N-SPAT
    STRING FUNCTION TRIM(WS-DIR) "/l.csv" DELIMITED BY SIZE INTO WS-N-SLAB
    STRING FUNCTION TRIM(WS-DIR) "/a.csv" DELIMITED BY SIZE INTO WS-N-SAE
    STRING FUNCTION TRIM(WS-DIR) "/r.csv" DELIMITED BY SIZE INTO WS-N-SREJ.

DO-OPEN.
    PERFORM STAGE-NAMES
    CALL "CBL_CREATE_DIR" USING WS-DIR
    OPEN OUTPUT S-PAT S-LAB S-AE S-REJ.

DO-PUT.
    EVALUATE LK-KIND
        WHEN "PAT " MOVE LK-LINE TO S-PAT-REC WRITE S-PAT-REC
        WHEN "LAB " MOVE LK-LINE TO S-LAB-REC WRITE S-LAB-REC
        WHEN "AE  " MOVE LK-LINE TO S-AE-REC WRITE S-AE-REC
        WHEN "REJ " MOVE LK-LINE TO S-REJ-REC WRITE S-REJ-REC
        WHEN OTHER MOVE 1 TO LK-STATUS
    END-EVALUATE.

DO-CLOSE.
    CLOSE S-PAT S-LAB S-AE S-REJ.

DO-PRMINIT.
    INITIALIZE WS-OUT-ROWS(1) WS-OUT-ROWS(2) WS-OUT-ROWS(3) WS-OUT-ROWS(4)
    CALL "CBL_CREATE_DIR" USING "work/out"
    OPEN OUTPUT O-PAT O-LAB O-AE O-REJ
    WRITE O-PAT-REC FROM WS-HDR-PAT
    WRITE O-LAB-REC FROM WS-HDR-LAB
    WRITE O-AE-REC FROM WS-HDR-AE
    WRITE O-REJ-REC FROM WS-HDR-REJ.

DO-PROMOTE.
    PERFORM STAGE-NAMES
    IF LK-KIND = "WRIT"
        MOVE "WRITTEN" TO WS-DISP
        PERFORM COPY-PAT-TOP
        PERFORM COPY-LAB-TOP
        PERFORM COPY-AE-TOP
    ELSE
        MOVE "HELD" TO WS-DISP
        CALL "CBL_CREATE_DIR" USING "work/out/held"
        MOVE SPACES TO WS-N-H
        STRING "work/out/held/" FUNCTION TRIM(LK-COHORT) DELIMITED BY SIZE INTO WS-N-H
        CALL "CBL_CREATE_DIR" USING WS-N-H
        PERFORM COPY-HELD
    END-IF
    PERFORM COPY-REJ-TOP.

*> Staged lines are copied verbatim; the three copy loops differ only in file names.
COPY-PAT-TOP.
    MOVE WS-N-SPAT TO WS-N-IN
    OPEN INPUT IN-F
    PERFORM READ-IN
    PERFORM UNTIL WS-EOF = "Y"
        WRITE O-PAT-REC FROM IN-REC
        ADD 1 TO WS-OUT-ROWS(1)
        PERFORM READ-IN
    END-PERFORM
    CLOSE IN-F.

COPY-LAB-TOP.
    MOVE WS-N-SLAB TO WS-N-IN
    OPEN INPUT IN-F
    PERFORM READ-IN
    PERFORM UNTIL WS-EOF = "Y"
        WRITE O-LAB-REC FROM IN-REC
        ADD 1 TO WS-OUT-ROWS(2)
        PERFORM READ-IN
    END-PERFORM
    CLOSE IN-F.

COPY-AE-TOP.
    MOVE WS-N-SAE TO WS-N-IN
    OPEN INPUT IN-F
    PERFORM READ-IN
    PERFORM UNTIL WS-EOF = "Y"
        WRITE O-AE-REC FROM IN-REC
        ADD 1 TO WS-OUT-ROWS(3)
        PERFORM READ-IN
    END-PERFORM
    CLOSE IN-F.

*> Rejected rows of every cohort go to the top-level reject.csv with the
*> cohort's final disposition appended.
COPY-REJ-TOP.
    MOVE WS-N-SREJ TO WS-N-IN
    OPEN INPUT IN-F
    PERFORM READ-IN
    PERFORM UNTIL WS-EOF = "Y"
        MOVE SPACES TO WS-LINE
        STRING FUNCTION TRIM(IN-REC) "," FUNCTION TRIM(WS-DISP)
            DELIMITED BY SIZE INTO WS-LINE
        WRITE O-REJ-REC FROM WS-LINE
        ADD 1 TO WS-OUT-ROWS(4)
        PERFORM READ-IN
    END-PERFORM
    CLOSE IN-F.

COPY-HELD.
    MOVE SPACES TO WS-DIR
    MOVE WS-N-H TO WS-DIR
    MOVE SPACES TO WS-N-H
    STRING FUNCTION TRIM(WS-DIR) "/patients.csv" DELIMITED BY SIZE INTO WS-N-H
    MOVE WS-N-SPAT TO WS-N-IN
    MOVE WS-HDR-PAT TO WS-LINE
    PERFORM COPY-ONE-HELD
    MOVE SPACES TO WS-N-H
    STRING FUNCTION TRIM(WS-DIR) "/lab_results.csv" DELIMITED BY SIZE INTO WS-N-H
    MOVE WS-N-SLAB TO WS-N-IN
    MOVE WS-HDR-LAB TO WS-LINE
    PERFORM COPY-ONE-HELD
    MOVE SPACES TO WS-N-H
    STRING FUNCTION TRIM(WS-DIR) "/adverse_events.csv" DELIMITED BY SIZE INTO WS-N-H
    MOVE WS-N-SAE TO WS-N-IN
    MOVE WS-HDR-AE TO WS-LINE
    PERFORM COPY-ONE-HELD.

COPY-ONE-HELD.
    OPEN OUTPUT H-F
    WRITE H-REC FROM WS-LINE
    OPEN INPUT IN-F
    PERFORM READ-IN
    PERFORM UNTIL WS-EOF = "Y"
        WRITE H-REC FROM IN-REC
        PERFORM READ-IN
    END-PERFORM
    CLOSE IN-F H-F.

READ-IN.
    MOVE "N" TO WS-EOF
    READ IN-F AT END MOVE "Y" TO WS-EOF END-READ.

DO-PRMDONE.
    CLOSE O-PAT O-LAB O-AE O-REJ.

DO-ROWS.
    EVALUATE LK-KIND
        WHEN "PAT " MOVE WS-OUT-ROWS(1) TO LK-COUNT
        WHEN "LAB " MOVE WS-OUT-ROWS(2) TO LK-COUNT
        WHEN "AE  " MOVE WS-OUT-ROWS(3) TO LK-COUNT
        WHEN "REJ " MOVE WS-OUT-ROWS(4) TO LK-COUNT
        WHEN OTHER MOVE 1 TO LK-STATUS
    END-EVALUATE.
